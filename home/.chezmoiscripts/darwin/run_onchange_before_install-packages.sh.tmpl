#!/bin/bash

set -eufo pipefail

{{ $brews := list
  "direnv"
  "emacs"
  "fd"
  "git"
  "gnupg"
  "jq"
  "neovim"
  "node"
  "pinentry-mac"
  "pkg-config"
  "ripgrep"
  "starship"
  "tmux"
  "uv" -}}

{{ $casks := list
  "balenaetcher"
  "battery"
  "docker"
  "ente-auth"
  "languagetool"
  "google-chrome"
  "hammerspoon"
  "keybase"
  "macfuse"
  "microsoft-remote-desktop"
  "scroll-reverser"
  "slack"
  "telegram"
  "visual-studio-code"
  "wezterm"
  "whatsapp"
  "zoom" -}}


brew bundle --no-lock --file=/dev/stdin <<EOF
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF

